# Copy to .env.production, never commit the filled file.
PUBLIC_DOMAIN=campus.example.com
# Use URL-safe random hex values; the DB password is used in a connection URL.
POSTGRES_PASSWORD=REPLACE_WITH_48_RANDOM_HEX_CHARACTERS
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
AMAP_KEY=
AMAP_SECURITY_CODE=
BRAND_NAME=烟火地图
# Payments stay off until each real merchant is independently onboarded.
WECHAT_PAY_ENABLED=false
# Only for the optional compose.payments.yaml overlay. Use an existing absolute
# server directory outside this repository; it is mounted read-only, never built in.
WECHAT_PAY_SECRETS_DIR=
# Set true ONLY when the supplied Caddy is the direct public entry point and
# backend:8000 cannot be reached by clients or untrusted services.
WECHAT_PAY_TRUST_PROXY_CLIENT_IP=false
