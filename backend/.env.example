# Copy values into the shell environment; Django does not implicitly load .env files.
DJANGO_ENV=development
DEMO_MODE=true
# Explicit development rehearsal only. Orders retain their original mode.
SERVICES_SIMULATION_ENABLED=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
BRAND_NAME=烟火地图
# Both map values must be provided before the real map is enabled.
AMAP_KEY=
AMAP_SECURITY_CODE=

# Production values (remove the # and supply real values):
# DJANGO_ENV=production
# DEMO_MODE=false
# DJANGO_SECRET_KEY=<random-secret-at-least-40-characters>
# DJANGO_ALLOWED_HOSTS=campus.example.com
# CSRF_TRUSTED_ORIGINS=https://campus.example.com
# DATABASE_URL=postgresql://app:password@db:5432/yanhuo
# DB_SSLMODE=require
# TRUST_PROXY=true
# Only behind the supplied Caddy proxy (or equivalent) that overwrites X-Real-IP:
# AUTH_TRUST_PROXY_CLIENT_IP=true
# Failed-login limits shared by API and admin; PostgreSQL counters work across processes.
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_FAILURE_ACCOUNT_LIMIT=10
AUTH_FAILURE_IP_LIMIT=60
PUBLIC_BASE_URL=
