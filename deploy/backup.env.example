# Store the configured copy in /etc/yanhuo/backup.env, mode 0600, outside Git.
# systemd EnvironmentFile syntax: literal values, no shell expansion.
BACKUP_PROJECT_DIR=/srv/yanhuo
# Must match the exact docker compose project label used at deployment.
BACKUP_PROJECT_NAME=yanhuo
BACKUP_ENV_FILE=/etc/yanhuo/production.env
BACKUP_STATE_DIR=/var/lib/yanhuo-backup
# Backups pause only this project's running app/callback/workers during capture.
# Confirm the documented short maintenance window before enabling the timer.
BACKUP_MAINTENANCE_APPROVED=false
BACKUP_OFFSITE_CONFIRMED=false
BACKUP_PAYMENTS_CONFIGURED=false
# Set true above and configure this directory whenever any old live payment exists.
WECHAT_PAY_SECRETS_DIR=
# A pre-initialized encrypted repository on an independently operated host/account.
# No local fallback, no automatic restic init, no insecure-no-password mode.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/yanhuo/restic-password
# Restic's S3/SFTP/provider credentials must also be configured outside Git.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BACKUP_FAILURE_WEBHOOK_FILE=/etc/yanhuo/backup-failure-webhook
BACKUP_RPO_SECONDS=3600
BACKUP_RTO_SECONDS=7200
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
