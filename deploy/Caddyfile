{$PUBLIC_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 6MiB
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=()"
        X-Frame-Options DENY
        Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        # Candidate resource policy is report-only until real AMap/device traffic
        # has been checked. Browser consoles expose violations; no report payload
        # collector receives URLs, pickup codes, or payment data.
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://webapi.amap.com https://*.amap.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.amap.com https://*.autonavi.com; connect-src 'self' https://*.amap.com https://*.autonavi.com; font-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
    handle /api/v1/payments/wechat/notify/* {
        request_body {
            max_size 2MiB
        }
        reverse_proxy callback:8088 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle /api/* {
        reverse_proxy backend:8000 {
            # Overwrite untrusted incoming values. Caddy must face clients directly.
            header_up X-Real-IP {remote_host}
        }
    }
    @admin path /admin /admin/*
    handle @admin {
        # Operators may narrow the back office to known addresses (space-separated
        # CIDRs in ADMIN_ALLOWED_IPS). Unset keeps the previous open behaviour.
        @admin_outside not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
        respond @admin_outside 403
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    @protected_qr path /media/merchants/*/qr-*
    handle @protected_qr {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle_path /static/* {
        root * /srv/backend-static
        file_server
    }
    handle_path /media/* {
        @any_qr path_regexp (?i)(^|/)qr-
        respond @any_qr 404
        header X-Content-Type-Options nosniff
        header Content-Security-Policy "sandbox; default-src 'none'; img-src 'self'; style-src 'none'; frame-ancestors 'none'"
        root * /srv/backend-media
        file_server
    }
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }
    handle {
        @spa_entrypoints path / /index.html /notification-worker.js
        header @spa_entrypoints Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
